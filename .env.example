# ===========================================
# 悠行 - 环境变量配置模板
#
# 使用方法：
#   1. 复制本文件为 .env  (cp .env.example .env)
#   2. 把下面的占位符替换成你的真实Key
#   3. 没有Key的先留空，页面会用模拟数据，不影响预览
#   4. 改完保存后重启服务 (Ctrl+C 停止，再运行 npm start)
# ===========================================

# ---- 高德地图 Key（核心，必配）----
# 注册地址: https://lbs.amap.com/
# 步骤: 注册账号 → 控制台 → 应用管理 → 创建新应用 → 添加Key → 选择"Web服务"
# 个人免费，每日5000次配额
AMAP_KEY=

# ---- 和风天气 Key（推荐配置）----
# 注册地址: https://dev.qweather.com/
# 步骤: 注册账号 → 控制台 → 应用管理 → 创建应用 → 获取Key
# 免费版每日1000次，提供7天预报+气象预警
QWEATHER_KEY=

# ---- 微信小程序凭据（后期接入推送时才需要）----
# 注册地址: https://mp.weixin.qq.com/
# 步骤: 注册小程序账号 → 开发管理 → 开发设置 → 获取AppID和AppSecret
# 用于实现"出发前一天20:00推送提醒"功能
WX_APPID=
WX_SECRET=

# ---- 携程联盟ID（可选，用于分销佣金链接）----
# 注册地址: https://u.ctrip.com/
CTRIP_AID=

# ---- 服务端口（默认3000，一般不用改）----
PORT=3000
