<!-- 悠行 - 攻略检索 (5A景区版) -->
<view class="page-container">

  <!-- 搜索框 -->
  <view class="card">
    <view class="search-bar">
      <input class="input" placeholder="输入城市或景区名..." value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="doSearch" />
      <button class="btn btn-primary btn-sm" bindtap="doSearch">搜索</button>
    </view>
    <view class="tag-row" style="margin-top:8px">
      <view class="tag" wx:for="{{hotTags}}" wx:key="*this" bindtap="quickSearch" data-tag="{{item}}">{{item}}</view>
    </view>
  </view>

  <!-- 5A景区导览 -->
  <view wx:if="{{scenicList.length > 0}}">
    <view class="a5-section-title">
      🏞️ 国家5A级景区
      <text class="tag tag-blue" style="margin-left:6px">{{scenicTotal}} 处</text>
      <text wx:if="{{scenicCities > 1}}" style="font-size:11px;color:var(--text-muted);margin-left:4px">覆盖{{scenicCities}}县市</text>
    </view>
    <view wx:for="{{scenicList}}" wx:for-item="area" wx:key="name" class="a5-card">
      <view class="a5-card-header">
        <view class="a5-card-name">🏷️ {{area.name}}</view>
        <view class="a5-card-loc">{{area.province}} · {{area.city}}{{area.district ? ' · ' + area.district : ''}}</view>
      </view>
      <view class="a5-card-desc">{{area.desc}}</view>
      <view class="a5-card-ticket">🎫 {{area.ticket}}</view>
      <!-- 景区地图 -->
      <view wx:if="{{area.mapUrl}}" class="a5-map-wrap">
        <image class="a5-map-img" src="{{area.mapUrl}}" mode="aspectFill" bindtap="previewMap" data-url="{{area.mapUrl}}" />
      </view>
    </view>
  </view>

  <!-- 攻略链接检索结果 -->
  <view wx:if="{{list.length > 0}}">
    <view class="card" style="margin-top:12px">
      <view class="card-title">📖 攻略链接
        <text wx:if="{{dataSource === 'live'}}" class="tag tag-blue">实时</text>
      </view>
      <view wx:for="{{list}}" wx:key="title" class="guide-card" bindtap="openGuide" data-url="{{item.url}}">
        <view class="guide-title">{{item.title}}</view>
        <view class="guide-summary">{{item.summary}}</view>
        <view class="tag-row">
          <view class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
          <view class="tag tag-blue" style="margin-left:auto">{{item.src}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{searched && list.length === 0 && scenicList.length === 0}}" class="empty-state">
    <text class="empty-icon">📚</text>
    <text>没有找到「{{keyword}}」相关的5A景区或攻略</text>
    <text style="font-size:12px;display:block;margin-top:8px">试试搜索：杭州、黄山、桂林、西安</text>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-icon">🔍</text>
    <text>输入城市名搜索5A景区和旅行攻略</text>
    <text style="font-size:12px;display:block;margin-top:8px">覆盖全国358家5A级旅游景区</text>
  </view>

</view>
