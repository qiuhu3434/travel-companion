<!-- 悠行 - 主页：天气 + 日历 + 日期设置 -->
<view class="page-container">

  <!-- 城市选择 -->
  <view class="card">
    <view class="card-title">选择城市</view>
    <view class="search-bar">
      <input class="input" placeholder="输入城市名称" value="{{city}}" bindinput="onCityInput" bindconfirm="onCityConfirm" />
      <button class="btn btn-primary btn-sm" bindtap="onCityConfirm">确认</button>
    </view>
    <view wx:if="{{dataSourceText}}" class="alert alert-info" style="margin-top:12px;margin-bottom:0">
      {{dataSourceText}}
    </view>
  </view>

  <!-- 今日天气卡片 -->
  <view class="weather-box" wx:if="{{weather.temp}}">
    <view>
      <view style="font-size:15px;opacity:.9">今日天气 · {{city}} <text wx:if="{{weatherLoaded}}" class="tag tag-blue">实时</text></view>
      <view class="weather-temp">{{weather.temp}}°</view>
      <view class="weather-info">{{weather.desc}} · {{weather.wind}} · 湿度{{weather.humidity}}
        <text wx:if="{{weather.feelsLike}}"> · 体感{{weather.feelsLike}}°</text>
      </view>
    </view>
    <view style="font-size:56px">{{weatherIcon}}</view>
  </view>

  <!-- 七�预报 -->
  <view class="card" wx:if="{{forecast.length > 0}}">
    <view class="card-title">🌤️ {{city}} 七日天气预报
      <text wx:if="{{weatherLoaded}}" class="tag tag-blue">实时</text>
    </view>
    <scroll-view scroll-x class="forecast-row">
      <view wx:for="{{forecast}}" wx:key="date" class="forecast-card {{inTripRange(item.date) ? 'active' : ''}}">
        <view class="fc-date">{{item.dateShow}}
          <text wx:if="{{inTripRange(item.date)}}" class="fc-badge">行程</text>
        </view>
        <text class="fc-icon">{{getWeatherIcon(item.textDay || item.text)}}</text>
        <view class="fc-range">{{item.tempMin}}°~{{item.tempMax}}°</view>
        <view class="fc-desc">{{item.textDay || item.text || '--'}}</view>
        <view class="fc-wind">{{item.windDirDay}}{{item.windScaleDay}}级</view>
      </view>
    </scroll-view>
  </view>

  <!-- 出行时间设置 -->
  <view class="card">
    <view class="card-title">🕐 出行起始时间</view>
    <view class="grid-2">
      <view>
        <view class="field-label">出发日期</view>
        <picker mode="date" value="{{tripStart}}" bindchange="onStartChange">
          <view class="input">{{tripStart || '请选择'}}</view>
        </picker>
      </view>
      <view>
        <view class="field-label">返程日期</view>
        <picker mode="date" value="{{tripEnd}}" bindchange="onEndChange">
          <view class="input">{{tripEnd || '请选择'}}</view>
        </picker>
      </view>
      <view>
        <view class="field-label">出发时间</view>
        <picker mode="time" value="{{departTime}}" bindchange="onDepartTimeChange">
          <view class="input">{{departTime || '08:00'}}</view>
        </picker>
      </view>
      <view>
        <view class="field-label">返程时间</view>
        <picker mode="time" value="{{returnTime}}" bindchange="onReturnTimeChange">
          <view class="input">{{returnTime || '18:00'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 快速入口：预算 + 攻略 + 规划 -->
  <view class="grid-3" style="margin-bottom:12px">
    <button class="btn btn-outline" bindtap="goToBudget">
      💰 旅行经费
    </button>
    <button class="btn btn-outline" bindtap="goToGuides">
      🔍 攻略检索
    </button>
    <button class="btn btn-primary" bindtap="goToPlan">
      🧠 智能规划
    </button>
  </view>

  <!-- 气象预警 -->
  <view wx:if="{{warnings.length > 0}}" class="alert alert-danger">
    ⚠️ 气象预警：
    <view wx:for="{{warnings}}" wx:key="title" style="margin-top:8px">
      🔴 <text style="font-weight:700">{{item.title}}</text>
      <view>{{item.text}}</view>
      <view style="font-size:11px;opacity:.7">{{item.startTime}} ~ {{item.endTime}}</view>
    </view>
  </view>

</view>
